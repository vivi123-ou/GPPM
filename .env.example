# Sao chép thành .env rồi điền khoá. KHÔNG commit file .env
# 1 = dùng dữ liệu mock (không gọi AI), 0 = gọi AI thật
USE_MOCK=0

# gemini | groq | openai | ollama
LLM_PROVIDER=gemini
# Để trống = dùng model mặc định (gemini-3.5-flash / openai/gpt-oss-120b / qwen2.5:7b)
LLM_MODEL=
# Dự phòng khi provider chính lỗi/hết lượt: "provider" hoặc "provider:model" (mỗi model Groq có hạn mức riêng)
LLM_FALLBACK=groq,groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b,openai

GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434

# URL Demo Shop (chạy chung server TestPilot ở cổng 8000). Dùng 127.0.0.1, không dùng localhost (Windows chậm)
DEMO_SHOP_URL=http://127.0.0.1:8000

# Tài khoản demo ShopDemo (điền mật khẩu thật chỉ trong file .env trên máy cá nhân)
SHOP_DEMO_EMAIL=demo@example.com
SHOP_DEMO_PASSWORD=
