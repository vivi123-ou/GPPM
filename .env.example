# Sao chép thành .env rồi điền khoá. KHÔNG commit file .env
# 1 = dùng dữ liệu mock (không gọi AI), 0 = gọi AI thật
USE_MOCK=0

# gemini | groq | openai | ollama
LLM_PROVIDER=gemini
# Để trống = dùng model mặc định (gemini-3.5-flash / llama-3.3-70b-versatile / qwen2.5:7b)
LLM_MODEL=
# Provider dự phòng khi provider chính lỗi/hết lượt (bỏ qua cái chưa có khoá)
LLM_FALLBACK=groq,openai

GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434

# URL Demo Shop (chạy chung server TestPilot ở cổng 8000). Dùng 127.0.0.1, không dùng localhost (Windows chậm)
DEMO_SHOP_URL=http://127.0.0.1:8000
